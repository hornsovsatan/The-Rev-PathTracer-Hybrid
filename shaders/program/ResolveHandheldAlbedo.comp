//======// Input //===============================================================================//

layout(local_size_x = 256, local_size_y = 1) in;
const ivec3 workGroups = ivec3(1, 1, 1);

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Uniform //=============================================================================//

#include "/lib/universal/Uniform.glsl"

//======// SSBO //================================================================================//

#define HANDHELD_ALBEDO_ACCESS restrict
#include "/lib/lighting/HandheldAlbedo.glsl"

shared vec4 sharedSum[256];

//======// Main //================================================================================//
void main() {
	uint localIndex = gl_LocalInvocationID.x;
	vec4 sum = vec4(0.0);

	for (uint index = localIndex; index < HANDHELD_ALBEDO_BUCKET_COUNT;
		 index += gl_WorkGroupSize.x) {
		sum += vec4(handheldAlbedo.buckets[index]);
	}

	sharedSum[localIndex] = sum;
	barrier();

	for (uint stride = gl_WorkGroupSize.x >> 1u; stride > 0u; stride >>= 1u) {
		if (localIndex < stride) {
			sharedSum[localIndex] += sharedSum[localIndex + stride];
		}
		barrier();
	}

	if (localIndex == 0u) {
		float sampleCount = sharedSum[0].a;
		bool historyValid = handheldAlbedo.state.x == handheldAlbedoStateMagic;

		if (sampleCount > 0.0) {
			vec3 current = sharedSum[0].rgb * rcp(sampleCount);
			current *= rcp(handheldAlbedoQuantization);

			float blendWeight = 0.0;
			if (historyValid && handheldAlbedo.average.a > 0.0) {
				blendWeight = exp2(-frameTime * rcp(handheldAlbedoHalflife));
			}

			vec3 average = mix(current, handheldAlbedo.average.rgb, blendWeight);
			handheldAlbedo.average = vec4(average, 1.0);
			handheldAlbedo.state = uvec4(handheldAlbedoStateMagic, 0u, 0u, 0u);
		} else {
			uint missingFrames = historyValid ? handheldAlbedo.state.y + 1u : 1u;
			if (!historyValid || missingFrames > handheldAlbedoMaxMissingFrames) {
				handheldAlbedo.average = vec4(0.0);
			}
			handheldAlbedo.state = uvec4(
				handheldAlbedoStateMagic, missingFrames, 0u, 0u
			);
		}
	}
}
