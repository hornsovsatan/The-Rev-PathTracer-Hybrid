#extension GL_KHR_shader_subgroup_arithmetic : enable

//======// Utility //=============================================================================//

#include "/lib/Utility.glsl"

//======// Input //===============================================================================//

layout(local_size_x = HISTOGRAM_BIN_COUNT, local_size_y = 1) in;
const ivec3 workGroups = ivec3(1, 1, 1);

//======// Uniform //=============================================================================//

#include "/lib/universal/Uniform.glsl"

//======// SSBO //================================================================================//

#define SSBO_DECLARED_TPYE restrict
#include "/lib/universal/SSBO.glsl"

//======// Shared Memory //=======================================================================//

shared uint sharedPrefix[HISTOGRAM_BIN_COUNT];
shared uint sharedBinIndex[HISTOGRAM_BIN_COUNT];

//======// Function //============================================================================//

const float autoEvMin = min(AUTO_EV_MIN, AUTO_EV_MAX);
const float autoEvMax = max(AUTO_EV_MIN, AUTO_EV_MAX);
const float autoEvRange = max(autoEvMax - autoEvMin, EPS);

void ParallelSum(uint index, uint value) {
	#ifdef SUBGROUP_OPS
		uint sum = subgroupAdd(value);
		if (gl_SubgroupInvocationID == 0u) {
			sharedBinIndex[gl_SubgroupID] = sum;
		}
		barrier();

		if (gl_NumSubgroups <= gl_SubgroupSize) {
			if (gl_SubgroupID == 0u) {
				uint partialSum = index < gl_NumSubgroups ? sharedBinIndex[index] : 0u;
				partialSum = subgroupAdd(partialSum);
				if (gl_SubgroupInvocationID == 0u) {
					sharedBinIndex[0] = partialSum;
				}
			}
			barrier();
		} else {
			uint activeCount = gl_NumSubgroups;
			while (activeCount > 1u) {
				uint nextCount = (activeCount + 1u) >> 1u;
				if (index < nextCount && index + nextCount < activeCount) {
					sharedBinIndex[index] += sharedBinIndex[index + nextCount];
				}
				barrier();
				activeCount = nextCount;
			}
		}
	#else
		sharedBinIndex[index] = value;
		barrier();
		for (uint stride = HISTOGRAM_BIN_COUNT >> 1u; stride > 0u; stride >>= 1u) {
			if (index < stride) {
				sharedBinIndex[index] += sharedBinIndex[index + stride];
			}
			barrier();
		}
	#endif
}

uvec2 ParallelPrefixSum(uint index, uint histogramValue) {
	#ifdef SUBGROUP_OPS
		uint prefix = subgroupInclusiveAdd(histogramValue);
		uint subgroupSum = subgroupAdd(histogramValue);
		if (gl_SubgroupInvocationID == 0u) {
			sharedPrefix[gl_SubgroupID] = subgroupSum;
		}
		barrier();

		if (gl_NumSubgroups <= gl_SubgroupSize) {
			if (gl_SubgroupID == 0u) {
				uint subgroupPrefix = index < gl_NumSubgroups ? sharedPrefix[index] : 0u;
				subgroupPrefix = subgroupInclusiveAdd(subgroupPrefix);
				if (index < gl_NumSubgroups) {
					sharedPrefix[index] = subgroupPrefix;
				}
			}
			barrier();
		} else {
			if (index >= gl_NumSubgroups) {
				sharedPrefix[index] = 0u;
			}
			barrier();

			for (uint stride = 1u; stride < gl_NumSubgroups; stride <<= 1u) {
				uint subgroupPrefix = sharedPrefix[index];
				if (index < gl_NumSubgroups && index >= stride) {
					subgroupPrefix += sharedPrefix[index - stride];
				}
				barrier();
				if (index < gl_NumSubgroups) {
					sharedPrefix[index] = subgroupPrefix;
				}
				barrier();
			}
		}

		uint sampleCount = sharedPrefix[gl_NumSubgroups - 1u];
		prefix += gl_SubgroupID > 0u ? sharedPrefix[gl_SubgroupID - 1u] : 0u;
		return uvec2(prefix, sampleCount);
	#else
		sharedPrefix[index] = histogramValue;
		barrier();

		for (uint stride = 1u; stride < HISTOGRAM_BIN_COUNT; stride <<= 1u) {
			uint prefix = sharedPrefix[index];
			if (index >= stride) {
				prefix += sharedPrefix[index - stride];
			}
			barrier();
			sharedPrefix[index] = prefix;
			barrier();
		}

		return uvec2(sharedPrefix[index], sharedPrefix[HISTOGRAM_BIN_COUNT - 1u]);
	#endif
}

//======// Main //================================================================================//
void main() {
	uint index = gl_LocalInvocationIndex;

	// Get cumulative histogram
	uint histogramValue = exposure.histogram[index];
	uvec2 prefixData = ParallelPrefixSum(index, histogramValue);
	uint prefix = prefixData.x;
	uint sampleCount = prefixData.y;

	const float lowerFraction = min(HISTOGRAM_LOWER_BOUND, HISTOGRAM_UPPER_BOUND);
	const float upperFraction = max(HISTOGRAM_LOWER_BOUND, HISTOGRAM_UPPER_BOUND);

	uint lowerBound = uint(round(lowerFraction * float(sampleCount)));
	uint upperBound = uint(round(upperFraction * float(sampleCount)));

	// Get weighted bin index
	uint previousPrefix = prefix - histogramValue;
	uint binCount = clamp(prefix, lowerBound, upperBound);
	binCount -= clamp(previousPrefix, lowerBound, upperBound);
	ParallelSum(index, binCount * index);

	// Compute exposure value in thread 0
	if (index == 0u) {
		float prevExposure = exposure.value;
		float prevExposureEv = log2(maxEps(prevExposure) * rcp(0.18));

		float avgLogLuminance = float(sharedBinIndex[0]) / float(upperBound - lowerBound);
		avgLogLuminance *= autoEvRange / float(HISTOGRAM_BIN_COUNT - 1u);
		avgLogLuminance += autoEvMin;

		float exposureCurve = mix(0.65, 1.0, nightVision);
		float targetExposureEv = AUTO_EV_BIAS - exposureCurve * avgLogLuminance;
		float exposureRate =
            targetExposureEv > prevExposureEv ? EXPOSURE_SPEED_DOWN : EXPOSURE_SPEED_UP;
		float exposureEv = mix(targetExposureEv, prevExposureEv, exp2(-exposureRate * frameTime));
		exposure.value = exp2(exposureEv) * 0.18;
	}

	// Clear histogram bin
	exposure.histogram[index] = 0u;
}
